---
import { Font } from 'astro:assets';
import { SITE } from '../site.config';
import { href, isHomePath } from '../lib/paths';
import '../styles/global.css';

interface Props {
  /** Page title. Omitted on the home page, where the site name stands alone. */
  title?: string;
  description: string;
  /** OpenGraph type: `article` for essays, `website` for everything else. */
  type?: 'website' | 'article';
}

const { title, description, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('og.png', Astro.site).href;
const isHome = isHomePath(Astro.url.pathname);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      The only script on every page (the contact page adds its own form
      script and Cloudflare Turnstile). It runs synchronously in <head> so the theme
      is resolved before first paint, then owns the toggle for the rest of the
      page. No defer, no async, no module, no second tag.
    */}
    <script is:inline>
      (() => {
        const KEY = 'theme';
        // Two states the reader can pick, plus `system` as the default they
        // start in. The icon shows the theme they are in; clicking moves to
        // the other one, which is what a sun/moon pair can express honestly.
        const mq = matchMedia('(prefers-color-scheme: dark)');

        // The preference lives in memory; localStorage is only where it is
        // persisted. Reading it through a variable means the toggle still
        // works for the session when storage is unavailable (private mode,
        // blocked site data) instead of becoming a control that does nothing.
        let preference = 'system';
        try {
          const stored = localStorage.getItem(KEY);
          if (stored === 'light' || stored === 'dark') preference = stored;
        } catch {}

        // data-theme is always a concrete light or dark, never `system`, which
        // is what keeps every themed rule a single flat selector.
        const apply = () => {
          document.documentElement.dataset.theme =
            preference === 'system' ? (mq.matches ? 'dark' : 'light') : preference;
        };

        apply();

        const current = () =>
          preference === 'system' ? (mq.matches ? 'dark' : 'light') : preference;

        const label = (button) => {
          const next = current() === 'dark' ? 'light' : 'dark';
          button.setAttribute('aria-label', `Switch to ${next} theme`);
        };

        // Follow a live OS switch, but only while the user is on `system`.
        // The label names the other theme, so it has to follow too, or the
        // button announces a switch to the theme the page is already in.
        mq.addEventListener('change', () => {
          if (preference !== 'system') return;
          apply();
          const button = document.getElementById('theme-toggle');
          if (button) label(button);
        });

        // Delegated, so it can be attached now — document already exists.
        document.addEventListener('click', (event) => {
          const target = event.target;
          const button =
            target instanceof Element ? target.closest('#theme-toggle') : null;
          if (!button) return;

          preference = current() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(KEY, preference);
          } catch {}

          apply();
          label(button);
        });

        // The button ships hidden, so with scripting off there is no dead
        // control: hidden elements are neither focusable nor exposed to AT.
        // The RSS icon beside it already sets the header row's height, so
        // revealing it here shifts nothing.
        document.addEventListener('DOMContentLoaded', () => {
          const button = document.getElementById('theme-toggle');
          if (!button) return;
          label(button);
          button.removeAttribute('hidden');
        });
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Link previews (Slack, LinkedIn, X, iMessage) read these, not <title>.
         og:url comes from the same canonical origin as the link above, and the
         image is the card src/pages/og.png.js draws from site.config.ts. */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}. ${SITE.description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Declaring an SVG icon suppresses the browser's unprompted /favicon.ico
         request, which would otherwise 404 into the console on every page. */}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL('rss.xml', Astro.site).href}
    />

    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        {!isHome && <a class="site-name" href={href('/')}>{SITE.name}</a>}
        <div class="links">
          <nav aria-label="Sections">
            <a href={href('/writing/')}>Writing</a>
            <a href={href('/projects/')}>Projects</a>
            <a href={href('/about/')}>About</a>
          </nav>
          <p class="utils">
            <a class="icon" href={href('/rss.xml')} aria-label="RSS feed">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="6.2" cy="17.8" r="2.2" fill="currentColor" />
                <path d="M4 11.2a8.8 8.8 0 0 1 8.8 8.8M4 4.6A15.4 15.4 0 0 1 19.4 20"
                  fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
              </svg>
            </a>
            <button id="theme-toggle" class="icon" type="button" hidden>
              <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4.4" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M12 1.8v2.6M12 19.6v2.6M22.2 12h-2.6M4.4 12H1.8M19.2 4.8l-1.9 1.9M6.7 17.3l-1.9 1.9M19.2 19.2l-1.9-1.9M6.7 6.7 4.8 4.8"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M20.5 14.6A8.8 8.8 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </button>
          </p>
        </div>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <a href={href('/contact/')}>Contact</a>
          {SITE.links.map((link) => (
            <>{' · '}<a href={link.href}>{link.label}</a></>
          ))}
        </p>
      </div>
    </footer>
  </body>
</html>
