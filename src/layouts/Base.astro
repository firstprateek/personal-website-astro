---
import { Font } from 'astro:assets';
import { SITE } from '../site.config';
import { href } from '../lib/paths';
import '../styles/global.css';

interface Props {
  /** Page title. Omitted on the home page, where the site name stands alone. */
  title?: string;
  description: string;
  /** OpenGraph type: `article` for essays, `website` for everything else. */
  type?: 'website' | 'article';
  /** The footer repeats the contact links; About already lists them. */
  footer?: boolean;
}

const { title, description, type = 'website', footer = true } = Astro.props;
const onHome = Astro.url.pathname === href('/');
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('og.png', Astro.site).href;
const stats = SITE.stats.endpoint || undefined;
const statsHost = stats ? new URL(SITE.url).host : undefined;
---
<html lang="en" data-pulse={stats} data-pulse-host={statsHost}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      The only script on every page (the contact page adds its own form
      script and Cloudflare Turnstile). It runs synchronously in <head> so the theme
      is resolved before first paint, then owns the toggle for the rest of the
      page, and counts the visit (stats/ in the repo). No defer, no async, no
      module, no second tag.
    */}
    <script is:inline>
      (() => {
        const KEY = 'theme';
        // Two states the reader can pick, plus `system` as the default they
        // start in (and return to by picking the OS's own theme). The icon shows the theme they are in; clicking moves to
        // the other one, which is what a sun/moon pair can express honestly.
        const mq = matchMedia('(prefers-color-scheme: dark)');

        // The preference lives in memory; localStorage is only where it is
        // persisted. Reading it through a variable means the toggle still
        // works for the session when storage is unavailable (private mode,
        // blocked site data) instead of becoming a control that does nothing.
        let preference = 'system';
        try {
          const stored = localStorage.getItem(KEY);
          if (stored === 'light' || stored === 'dark') preference = stored;
        } catch {}

        // data-theme is always a concrete light or dark, never `system`, which
        // is what keeps every themed rule a single flat selector.
        const apply = () => {
          document.documentElement.dataset.theme =
            preference === 'system' ? (mq.matches ? 'dark' : 'light') : preference;
        };

        apply();

        const current = () =>
          preference === 'system' ? (mq.matches ? 'dark' : 'light') : preference;

        const label = (button) => {
          const next = current() === 'dark' ? 'light' : 'dark';
          button.setAttribute('aria-label', `Switch to ${next} theme`);
        };

        // Follow a live OS switch, but only while the user is on `system`.
        // The label names the other theme, so it has to follow too, or the
        // button announces a switch to the theme the page is already in.
        mq.addEventListener('change', () => {
          if (preference !== 'system') return;
          apply();
          const button = document.getElementById('theme-toggle');
          if (button) label(button);
        });

        // A rule under the sticky header once the page has scrolled.
        const onScroll = () => {
          document.documentElement.toggleAttribute('data-scrolled', scrollY > 4);
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // Visit counting: no cookies, nothing that names the reader. One beacon
        // when the page opens, one each time it is hidden (seconds on screen
        // and how far down it was read), one per link off the site. Only on
        // the real host, and never on a device opted out with ?notrack
        // (?track opts back in). The Worker is in stats/; DEPLOY.md has more.
        // Wrapped whole, so nothing here can stop the theme toggle below.
        try {
        const root = document.documentElement;
        const endpoint = root.dataset.pulse;
        let counted = Boolean(endpoint) && location.host === root.dataset.pulseHost;
        try {
          const query = new URLSearchParams(location.search);
          if (query.has('notrack')) localStorage.setItem('notrack', '1');
          if (query.has('track')) localStorage.removeItem('notrack');
          if (localStorage.getItem('notrack') === '1') counted = false;
        } catch {}
        if (counted && navigator.sendBeacon) {
          const id = Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) =>
            b.toString(16).padStart(2, '0')).join('');
          const send = (data) => {
            try {
              navigator.sendBeacon(endpoint, JSON.stringify({ id, ...data }));
            } catch {}
          };
          const query = new URLSearchParams(location.search);
          send({
            t: 'view',
            p: location.pathname,
            r: document.referrer,
            s: query.get('utm_source') || query.get('ref') || '',
          });

          let shownAt = document.visibilityState === 'visible' ? performance.now() : null;
          let shown = 0;
          let depth = 0;
          const measure = () => {
            const height = root.scrollHeight;
            const seen = height ? ((scrollY + innerHeight) / height) * 100 : 100;
            depth = Math.max(depth, Math.min(100, Math.round(seen)));
          };
          addEventListener('scroll', measure, { passive: true });
          addEventListener('load', measure);
          // Sent on hide and again on pagehide, which is the one that fires
          // reliably when a link leads to another page. The Worker keeps the
          // largest values, so a repeat changes nothing.
          const leave = () => {
            if (shownAt !== null) shown += performance.now() - shownAt;
            shownAt = null;
            measure();
            send({ t: 'leave', sec: Math.round(shown / 1000), d: depth });
          };
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden') leave();
            else shownAt = performance.now();
          });
          addEventListener('pagehide', leave);

          const outbound = (event) => {
            const link =
              event.target instanceof Element ? event.target.closest('a[href]') : null;
            if (link && /^https?:$/.test(link.protocol) && link.host !== location.host) {
              send({ t: 'out', h: link.href });
            }
          };
          document.addEventListener('click', outbound);
          document.addEventListener('auxclick', outbound);
        }
        } catch {}

        // Delegated, so it can be attached now — document already exists.
        document.addEventListener('click', (event) => {
          const target = event.target;
          const button =
            target instanceof Element ? target.closest('#theme-toggle') : null;
          if (!button) return;

          // A choice that matches the OS is no choice at all: go back to
          // `system` and forget the stored value, so the page follows the OS
          // again. Only a theme that differs from the OS is remembered.
          const next = current() === 'dark' ? 'light' : 'dark';
          const os = mq.matches ? 'dark' : 'light';
          preference = next === os ? 'system' : next;
          try {
            if (preference === 'system') localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, preference);
          } catch {}

          apply();
          label(button);
        });

        // The button ships hidden, so with scripting off there is no dead
        // control: hidden elements are neither focusable nor exposed to AT.
        // .utils reserves the button's 40px height, so revealing it here
        // shifts nothing.
        document.addEventListener('DOMContentLoaded', () => {
          const button = document.getElementById('theme-toggle');
          if (!button) return;
          label(button);
          button.removeAttribute('hidden');
        });
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Link previews (Slack, LinkedIn, X, iMessage) read these, not <title>.
         og:url comes from the same canonical origin as the link above, and the
         image is the card src/pages/og.png.js draws from site.config.ts. */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}. ${SITE.description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Declaring an SVG icon suppresses the browser's unprompted /favicon.ico
         request, which would otherwise 404 into the console on every page. */}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL('rss.xml', Astro.site).href}
    />

    <Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href={href('/')} aria-current={onHome ? 'page' : undefined}>{SITE.name}</a>
        <div class="links">
          <nav aria-label="Sections">
            {[
              ['/projects/', 'Projects'],
              ['/writing/', 'Writing'],
              ['/about/', 'About'],
            ].map(([path, label]) => {
              const target = href(path);
              const at = Astro.url.pathname;
              // 'page' on the section's own index, 'true' anywhere inside it.
              const current = at === target ? 'page' : at.startsWith(target) ? 'true' : undefined;
              return <a href={target} aria-current={current}>{label}</a>;
            })}
          </nav>
          <p class="utils">
            <a class="icon" href={href('/rss.xml')} aria-label="RSS feed" title="RSS feed">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="6.2" cy="17.8" r="2.2" fill="currentColor" />
                <path d="M4 11.2a8.8 8.8 0 0 1 8.8 8.8M4 4.6A15.4 15.4 0 0 1 19.4 20"
                  fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
              </svg>
            </a>
            <button id="theme-toggle" class="icon" type="button" hidden>
              <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4.4" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M12 1.8v2.6M12 19.6v2.6M22.2 12h-2.6M4.4 12H1.8M19.2 4.8l-1.9 1.9M6.7 17.3l-1.9 1.9M19.2 19.2l-1.9-1.9M6.7 6.7 4.8 4.8"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M20.5 14.6A8.8 8.8 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </button>
          </p>
        </div>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    {footer && <footer class="site-footer">
      <div class="wrap">
        <p>
          <a href={href('/contact/')}>Contact</a>
          {SITE.links.map((link) => (
            <>{' · '}<a href={link.href}>{link.label}</a></>
          ))}
        </p>
      </div>
    </footer>}
  </body>
</html>
