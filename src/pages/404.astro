---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';

/* Built to /404.html. Netlify and Cloudflare Pages serve it, with a 404
   status, for any path that has no page; a Cloudflare Worker does only when
   told to (see DEPLOY.md). Without it, each host shows its own generic page. */
---
<Base title="Not found" description="There is no page at this address.">
  <h1>Not found</h1>
  <p>There is no page at this address. It may have moved, or the link may have a typo in it.</p>
  <p><a href={href('/')}>Go to the home page</a> <a href={href('/no-such-page/')}>x</a></p>
</Base>
