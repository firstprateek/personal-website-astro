---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import { href } from '../lib/paths';
import portrait from '../assets/portrait.jpg';
---
<Base title="About" description={SITE.description} footer={false}>
  <h1>About</h1>
  {/* The portrait floats left and the text wraps beside and then under it.
       flow-root keeps the float inside this block, so Elsewhere below always
       starts on a clean line. */}
  <div class="about-body">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[176, 352, 528]}
      sizes="(max-width: 40rem) 7.5rem, 11rem"
      alt={`Portrait of ${SITE.name}`}
      class="portrait"
      loading="eager"
    />
    {SITE.about.map((line) => <p set:html={line} />)}
  </div>

  <h2>Elsewhere</h2>
  <ul class="plain">
    <li><a href={href('/contact/')}>Contact form</a></li>
    {SITE.links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
    <li><a href={href('/rss.xml')}>RSS feed</a></li>
  </ul>
</Base>
