---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';
import WritingList from '../components/WritingList.astro';
import { SITE } from '../site.config';
import { getCurrentProjects, getPosts } from '../lib/content';

const allPosts = await getPosts();
/* The home page is a front door, not an archive: the three most recent, then
   a plain link to the rest when there are more. */
const HOME_POSTS = 3;
const posts = allPosts.slice(0, HOME_POSTS);
const hasMore = allPosts.length > HOME_POSTS;
const current = await getCurrentProjects(SITE.currentProjects);
---
<Base description={SITE.description}>
  <h1>{SITE.name}</h1>
  {SITE.bio.map((line) => <p>{line}</p>)}

  {
    /* Omitted entirely when the list is empty: no empty slot, no placeholder. */
    current.length > 0 && (
      <section>
        <h2>Current projects</h2>
        <ul class="entries">
          {current.map((project) => (
            <li>
              <h3>
                <a href={href(`/projects/${project.id}/`)}>{project.data.title}</a>
              </h3>
              <p>{project.data.summary}</p>
            </li>
          ))}
        </ul>
        <p><a href={href('/projects/')}>All projects</a></p>
      </section>
    )
  }

  <section>
    <h2>Recent articles</h2>
    <WritingList posts={posts} level={3} />
    {hasMore && (
      <p><a href={href('/writing/')}>All writing</a></p>
    )}
  </section>
</Base>
