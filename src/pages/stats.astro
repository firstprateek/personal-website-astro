---
/**
 * pjoshi.dev/stats/: a short, memorable door to the private stats dashboard
 * (the Worker in stats/, signed in by Telegram link). The site is static, so
 * this forwards rather than serving the dashboard itself. Not indexed, and it
 * has no script, so a visit here is not counted.
 */
import { SITE } from '../site.config';
import { href } from '../lib/paths';

const target = SITE.stats.dashboard;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    {target && <meta http-equiv="refresh" content={`0; url=${target}`} />}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <title>Stats</title>
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; padding: 32px 16px; font: 16px/1.5 system-ui, sans-serif;
        background: light-dark(#fdfcfa, #17181a); color: light-dark(#1f1d1a, #e4e1db); }
      a { color: light-dark(#c4402f, #de5043); text-decoration: none; }
    </style>
  </head>
  <body>
    {target
      ? <p>Opening <a href={target}>the stats dashboard</a>…</p>
      : <p>No stats dashboard is set up.</p>}
  </body>
</html>
