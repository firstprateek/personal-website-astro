---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/content';

export async function getStaticPaths() {
  // getPosts() already drops drafts, so a draft gets no route at all.
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description} type="article">
  <article>
    <h1>{entry.data.title}</h1>
    <p class="meta">
      <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
    </p>
    <Content />
  </article>
</Base>
