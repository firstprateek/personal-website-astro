---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { getPosts } from '../../lib/content';
import { href } from '../../lib/paths';

const posts = await getPosts();
---
<Base title="Writing" description="Essays and technical notes.">
  <h1>Writing</h1>
  <WritingList posts={posts} level={2} />
  <p class="meta">
    New articles are also in the <a href={href('/rss.xml')}>RSS feed</a>, for
    feed readers.
  </p>
</Base>
